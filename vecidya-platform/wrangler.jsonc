{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vecidya-platform",
  "compatibility_date": "2026-08-13",
  "main": "./workers/app.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "vecidya.com/*",
      "zone_name": "vecidya.com"
    },
    {
      "pattern": "www.vecidya.com/*",
      "zone_name": "vecidya.com"
    }
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "vars": {
    "APP_URL": "https://vecidya.com",
    "BETTER_AUTH_URL": "https://vecidya.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vecidya-staging",
      "database_id": "d4af6ebc-97c5-42f6-ad3a-51551021e591",
      "migrations_dir": "db/migrations"
    }
  ]
}
