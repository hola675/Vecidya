{
  "name": "vecidya-platform",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test:e2e": "node tests/e2e/run-local-e2e.mjs",
    "test:e2e:app-dashboard-redesign": "node tests/e2e/app-dashboard-redesign-check.mjs",
    "test:e2e:platform-admin-global": "node tests/e2e/platform-admin-global-certification-check.mjs",
    "test:e2e:diagnostic-act03": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs tests/e2e/diagnostic-v3-candidate-certification-check.mjs",
    "test:e2e:diagnostic-act04": "node tests/e2e/diagnostic-act-04-check.mjs",
    "test:e2e:diagnostic-act031": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs tests/e2e/diagnostic-v3-candidate-session-hardening-check.mjs && node --experimental-strip-types --import ./tests/unit/register-ts.mjs tests/e2e/diagnostic-v3-candidate-pdf-samples.mjs",
    "test:e2e:diagnostic-act032": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs tests/e2e/diagnostic-v3-candidate-session-hardening-check.mjs",
    "benchmark:diagnostic-candidate": "node tests/e2e/measure-diagnostic-candidate-bundle.mjs",
    "test:email": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs --test tests/email/mail-adapter.test.ts tests/email/mail-templates.test.ts",
    "test:unit": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs --test \"tests/unit/**/*.test.ts\"",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@fontsource/arimo": "5.3.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pdfkit": "0.20.2",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
