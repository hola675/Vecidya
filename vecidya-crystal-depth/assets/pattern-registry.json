      "urlExample": "/vecindario",
      "primaryMaterial": "quiet",
      "secondaryMaterial": "solid",
      "asset": "vecidya-platform/public/assets/selected/illustrations/neighborhood-scene.webp",
      "motion": [
        "section-reveal",
        "ui-feedback"
      ],
      "contentRule": "Búsqueda y filtros sólidos sobre escena contextual; resultados de negocio solo desde datos reales.",
      "avoid": [
        "resultados inventados",
        "animar listas durante lectura"
      ],
      "status": "demo-only-not-route"
    },
    {
      "id": "aprende",
      "intent": "contenido-editorial",
      "label": "Aprende",
      "urlExample": "/aprende",
      "primaryMaterial": "solid",
      "secondaryMaterial": "quiet",
      "asset": "vecidya-platform/public/assets/selected/illustrations/learn-journey-scene.webp",
      "motion": [
        "section-reveal"
      ],
      "contentRule": "Lectura y navegación editorial con superficie estable, tipografía accesible y énfasis contenido.",
      "avoid": [
        "fondos translúcidos bajo artículos largos",
        "parallax obligatorio"
      ],
      "status": "demo-only-not-route"
    },
    {
      "id": "miniweb",
      "intent": "editar-miniweb",
      "label": "MiniWeb V2",
      "urlExample": "editor y vista previa",
      "primaryMaterial": "solid",
      "secondaryMaterial": "quiet",
      "asset": "vecidya-platform/public/assets/selected/illustrations/services-scene.webp",
      "motion": [
        "ui-feedback"
      ],
      "contentRule": "Editor estático y vista previa separada; persistencia, permisos y publicación deben ser verificadas en plataforma antes de habilitar.",
      "avoid": [
        "simular publicación exitosa",
        "suponer entitlements por plan",
        "perder contenido al cambiar estilo"
      ],
      "status": "demo-only-not-route"
    }
  ]
}
