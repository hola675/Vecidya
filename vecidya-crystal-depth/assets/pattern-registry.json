  "assetRules": {
    "brand": "usar-solo-activos-originales-verificados",
    "vico": "no-sustituir-mascota-ni-alterar-proporciones",
    "images": "conservar-originales; optimizar-derivados; registrar-origen/licencia",
    "catalog": "140-activos-indexados-no-todos-deben-publicarse",
    "source": "vecidya-platform/public/assets",
    "registry": "assets/library-catalog.js"
  },
  "acceptance": [
    "tema-oscuro-predeterminado-y-claro-alternativo",
    "sin-derrame-horizontal-desde-320px",
    "contraste-4.5-texto-y-3-texto-grande-sobre-fondo-real",
    "foco-teclado-visible",
    "minimo-44px-en-controles-relevantes",
    "sin-color-como-unica-senal",
    "sin-movimiento-esencial-y-reduced-motion",
    "sin-cambios-de-rutas-datos-permisos-ni-publicacion",
    "capturas-en-320-390-768-1366-y-1920",
    "verificar-rendimiento-y-auditar-con-lector-de-pantalla",
    "animaciones pausables sin ocultar contenido",
    "modo reduced-motion respeta estado estático",
    "sin desbordamiento horizontal por transformaciones",
    "selección por teclado entre demos sin reemplazar rutas reales"
  ],
  "implementation": {
    "readFirst": [
      "AGENTS.md",
      "vecidya-platform/docs/GOVERNANCE.md",
      "vecidya-crystal-depth/docs/DIRECCION-ARTISTICA.md",
      "vecidya-crystal-depth/docs/INTEGRACION.md"
    ],
    "process": [
      "identificar-intencion",
      "consultar-intentRouting",
      "elegir-material-y-capacidad-real",
      "comprobar-assets-y-licencia",
      "consultar sceneRecipes para composición de pantalla, asset oficial y movimiento permitido",
      "crear-composicion",
      "elegir motion.presets y respetar preferencias de movimiento",
      "probar-estados-y-contraste",
      "obtener-aprobacion-antes-de-migrar"
    ],
    "doNot": "No importar CSS de este laboratorio directamente en producción ni fusionar sin autorización."
  },
  "schemaVersion": "1",
  "id": "vecidya-crystal-depth/pattern-registry-r1",
  "motion": {
    "version": "R1.1-candidate",
    "status": "laboratorio-no-integrado",
    "principle": "Movimiento funcional, mínimo, reversible; no sustituye contenido ni estados.",
    "presets": [
      {
        "id": "page-enter",
        "scope": "portada o inicio de escena",
        "durationMs": 580,
        "trigger": "first-paint",
        "css": "hero-copy; hero-visual",
        "avoid": [
          "dashboard",
          "tabla",
          "operación crítica"
        ]
      },
      {
        "id": "section-reveal",
        "scope": "secciones narrativas y guías",
        "durationMs": 480,
        "trigger": "intersección una vez",
        "css": ".vx-motion-reveal",
        "avoid": [
          "mostrar datos solo tras JS",
          "animaciones repetitivas en scroll"
        ]
      },
      {
        "id": "ui-feedback",
        "scope": "botones, pestañas y tarjetas no densas",
        "durationMsRange": [
          150,
          260
        ],
        "trigger": "hover/focus/estado",
        "css": ".crystal-button; .tab-panel; .component-card",
        "avoid": [
          "campos editables en movimiento",
          "shift de layout"
        ]
      },
      {
        "id": "ambient-drift",
        "scope": "hero y escenas L0-L3",
        "durationSecondsRange": [
          9,
          14
        ],
        "trigger": "escena visible",
        "css": ".hero-orbit; .hero-stage-glow; .motion-stage",
        "avoid": [
          "detrás de tablas",
          "contenido con movimiento obligatorio"
        ]
      },
      {
        "id": "section-navigation",
        "scope": "anclas y navegación contextual",
        "trigger": "click o navegación teclado",
        "css": "scroll-behavior: smooth (solo no reduced-motion)",
        "avoid": [
          "alterar URL/rutas",
          "scroll programático sin intención"
        ]
      }
    ],
    "modes": [
      "standard",
      "subtle",
      "static"
    ],
    "preference": "prefers-reduced-motion: reduce siempre prevalece sobre controles del laboratorio",
    "controls": [
      "Pausar/reanudar decoraciones animadas",
      "Repetir escena",
      "Intensidad estándar/discreta"
    ],
    "performance": [
      "priorizar opacity y transform",
      "sin dependencias JS externas",
      "sin layout shifts",
      "evitar efectos costosos en móvil"
    ],
    "accessibility": [
      "contenido visible sin JavaScript",
      "nunca depender de movimiento",
      "foco visible",
      "evitar autoplay esencial",
      "pausa de animación continua",
      "desactivar al reducir movimiento"
    ],
    "implementation": "La app React debe envolver animaciones en componentes opcionales, sin importar este CSS en producción ni simular transiciones de rutas sin contrato de navegación y QA."
  },
  "sceneRecipes": [
    {
      "id": "publico",
      "intent": "portada-marketing",
      "label": "Sitio público",
      "urlExample": "/ o /servicios",
      "primaryMaterial": "focal",
      "secondaryMaterial": "quiet",
      "asset": "vecidya-platform/public/assets/selected/illustrations/home-scene.webp",
      "motion": [
        "page-enter",
        "section-reveal",
        "ambient-drift"
      ],
      "contentRule": "Hero con propósito, CTA real y textos HTML contrastados; mascota oficial opcional, nunca obligatoria.",
      "avoid": [
        "texto dibujado dentro de imagen",
        "hero con efecto sobre navegación"
      ],
      "status": "demo-only-not-route"
    },
    {
      "id": "vecindario",
      "intent": "buscar-negocios",
